{
  "name": "sinwan-ui-registry",
  "version": "1.0.0",
  "private": true,
  "description": "Source of the sinwan-ui component registry: components copied into apps by the sinwan-ui CLI.",
  "author": "Mohammed Ben Cheikh",
  "license": "MIT",
  "homepage": "https://sinwanjs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinwanjs/sinwan-ui-registry"
  },
  "type": "module",
  "scripts": {
    "test": "bun test --coverage ./__tests__",
    "typecheck": "bunx tsc -p tsconfig.json",
    "typecheck:consumer": "bunx tsc -p tsconfig.consumer.json",
    "registry:build": "bun ../sinwan-ui/src/bin.ts build registry.json --output public/r"
  },
  "dependencies": {
    "@tanstack/table-core": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.1.0",
    "lucide": "^0.544.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-plugin-sinwan": "1.0.0",
    "happy-dom": "^20.14.5",
    "sinwan": ">=2.0.3 <3.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "sinwan-ui-core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "sinwan-ui-core": {
      "optional": true
    }
  }
}